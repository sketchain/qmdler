# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 运行时产物 —— 绝不能提交：凭证和设备指纹在这里
#
# 这些模式必须用 / 锚定到仓库根目录。不锚定的 `config/` 会匹配到
# src/qmdler/core/config/，而 hatchling 默认遵守 .gitignore，
# 打出来的 wheel 会缺整个配置子包。
/config/
/data/
/music/
*.db
*.db-wal
*.db-shm
*.log

# 凭证与设备指纹：任何位置、任何形态都不许进仓库。
# 这几条**故意不锚定** —— 它们要在任意子目录都生效；而且仓库里不存在同名的
# 源码文件或目录，不会像 `config/` 那样误伤打包。
credential.json
credential*.json
device.json
device*.json
*.credential
qrcode/
.qmdler-probe-*
# 诊断/抓包中间产物
raw_*.json
*.part

# 编辑器
.idea/
.vscode/
.DS_Store
